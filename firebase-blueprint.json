{
  "entities": {
    "shifts": {
      "title": "Shifts",
      "description": "Work shifts collection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "date": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "breakMinutes": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "employeeId", "date", "startTime", "endTime"]
    },
    "employees": {
      "title": "Employees",
      "description": "Employee directory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "avatarBg": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "users": {
      "title": "Users",
      "description": "User login account hash",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "passwordHash": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["username", "passwordHash"]
    },
    "timeoff": {
      "title": "Time Off Requests",
      "description": "Time off requests collection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "employeeId": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "type": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "employeeId", "startDate", "endDate"]
    },
    "swaps": {
      "title": "Shift Swaps",
      "description": "Shift swap requests collection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "requesterShiftId": { "type": "string" },
        "requesterId": { "type": "string" },
        "targetEmployeeId": { "type": "string" },
        "reason": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "requesterShiftId", "requesterId"]
    }
  }
}
